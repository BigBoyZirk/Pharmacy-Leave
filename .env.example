SECRET_KEY=change-me-to-a-long-random-string

# Admin login (created on first run if missing)
ADMIN_NAME=Pharmacy Manager
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# Used when a staff member submits a leave request
NOTIFY_ADMIN_EMAIL=admin@example.com

# Optional SMTP. Leave blank to skip sending mail (requests still work).
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
